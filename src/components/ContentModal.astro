---
---

<div id="modal" class="modal fixed inset-0 z-100 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-[opacity,visibility] duration-200 ease-out sm:p-6" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
  <div class="modal-bg absolute inset-0 bg-slate-900/80" data-modal-close tabindex="-1" aria-hidden="true"></div>
  <div class="modal-panel relative w-full max-w-2xl max-h-[90vh] overflow-hidden rounded-md border border-slate-200/90 bg-white shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25),0_0_0_1px_rgba(0,0,0,0.05)] transition-all duration-200 ease-out scale-[0.98]">
    <span class="pointer-events-none absolute left-0 top-0 z-20 h-px w-24 bg-blue-500/70" aria-hidden="true"></span>
    <div class="overflow-y-auto overflow-x-hidden max-h-[90vh]">
      <div class="relative">
        <div class="modal-gallery relative hidden w-full overflow-hidden px-3 pt-3">
          <div class="modal-carousel-wrapper relative w-full">
            <div class="modal-carousel flex transition-transform duration-500 ease-in-out" style="transform: translateX(0%)">
              <div class="modal-slide shrink-0 w-full">
                <img src="" alt="" class="w-full h-auto" />
              </div>
              <div class="modal-slide shrink-0 w-full">
                <img src="" alt="" class="w-full h-auto" />
              </div>
            </div>
            <button type="button" class="modal-carousel-prev absolute left-5 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-black/15 text-white backdrop-blur-md shadow-lg transition-all duration-300 hover:border-white/45 hover:bg-black/25" aria-label="Anterior">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button type="button" class="modal-carousel-next absolute right-5 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-black/15 text-white backdrop-blur-md shadow-lg transition-all duration-300 hover:border-white/45 hover:bg-black/25" aria-label="Siguiente">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </div>
        </div>
        <div class="px-8 pb-8 pt-7 sm:px-10 sm:pb-10 sm:pt-8">
        <h2 id="modal-title" class="pr-12 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl"></h2>
        <span class="mt-3 block h-0.5 w-16 rounded-full bg-blue-600"></span>
        <div class="modal-body mt-5 text-base leading-relaxed text-slate-600 sm:text-lg"></div>
        <div class="modal-specs mt-6 hidden rounded-md border border-slate-100 bg-slate-50/80 p-5 sm:p-6"></div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#cotizar" class="modal-cta inline-flex items-center gap-2.5 rounded-md bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-md">
            Cotizar
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <button type="button" class="cursor-pointer rounded-md border border-slate-200 bg-white px-5 py-2.5 text-sm font-medium text-slate-600 transition-all duration-300 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700" data-modal-close>
            Cerrar
          </button>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>

<style>
  .modal.is-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }
  .modal.is-open .modal-panel {
    transform: scale(1);
  }
  .modal:not(.is-open) {
    visibility: hidden;
  }
  .modal-gallery {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }
  .modal-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 0.375rem;
  }
  .modal-carousel {
    display: flex;
    width: 100%;
  }
  .modal-slide {
    flex-shrink: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-slide img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }
</style>

<script is:inline>
(function () {
  var modal = document.getElementById("modal");
  var titleEl = document.getElementById("modal-title");
  var bodyEl = modal && modal.querySelector(".modal-body");
  var specsEl = modal && modal.querySelector(".modal-specs");
  var carouselGallery = modal && modal.querySelector(".modal-gallery");
  var carouselEl = modal && modal.querySelector(".modal-carousel");
  var carouselSlides = modal && modal.querySelectorAll(".modal-slide img");
  var currentSlide = 0;

  function esc(s) {
    var d = document.createElement("div");
    d.textContent = s;
    return d.innerHTML;
  }

  function updateCarousel() {
    if (!carouselEl) return;
    carouselEl.style.transform = "translateX(-" + (currentSlide * 100) + "%)";
  }

  function openModal(title, description, specsJson, imageUrl) {
    if (!modal || !titleEl || !bodyEl) return;
    titleEl.textContent = title || "";
    bodyEl.innerHTML = description ? "<p class=\"leading-relaxed text-slate-600\">" + esc(description) + "</p>" : "";
    
    if (carouselSlides && carouselGallery && imageUrl) {
      carouselGallery.classList.remove("hidden");
      carouselSlides.forEach(function(img) {
        img.src = imageUrl;
        img.alt = title || "";
      });
      currentSlide = 0;
      updateCarousel();
    } else if (carouselGallery) {
      carouselGallery.classList.add("hidden");
    }
    
    if (specsEl) {
      try {
        var specs = specsJson ? JSON.parse(specsJson) : [];
        if (Array.isArray(specs) && specs.length > 0) {
          specsEl.classList.remove("hidden");
          specsEl.innerHTML = "<p class=\"mb-4 text-xs font-semibold uppercase tracking-wider text-blue-600\">Especificaciones</p><dl class=\"grid grid-cols-2 gap-x-6 gap-y-3 text-sm\">" + specs.map(function (s) {
            return "<dt class=\"text-slate-500\">" + esc(s.label) + "</dt><dd class=\"font-semibold text-slate-800\">" + esc(s.value) + "</dd>";
          }).join("") + "</dl>";
        } else {
          specsEl.classList.add("hidden");
          specsEl.innerHTML = "";
        }
      } catch (_) {
        specsEl.classList.add("hidden");
        specsEl.innerHTML = "";
      }
    }
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", function (e) {
    var t = e.target.closest("[data-modal-open]");
    if (t) {
      e.preventDefault();
      openModal(t.getAttribute("data-modal-title") || "", t.getAttribute("data-modal-description") || "", t.getAttribute("data-modal-specs") || "", t.getAttribute("data-modal-image") || "");
      return;
    }
    if (e.target.closest("[data-modal-close]") || e.target.classList.contains("modal-bg") || e.target.closest(".modal-cta")) {
      closeModal();
    }
    if (e.target.closest(".modal-carousel-prev")) {
      currentSlide = currentSlide === 0 ? 1 : 0;
      updateCarousel();
    }
    if (e.target.closest(".modal-carousel-next")) {
      currentSlide = currentSlide === 1 ? 0 : 1;
      updateCarousel();
    }
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && modal && modal.classList.contains("is-open")) closeModal();
  });
})();
</script>
