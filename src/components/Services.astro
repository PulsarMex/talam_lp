---
import { Image } from "astro:assets";

const medicionGallery = [
  "/images/medicion/image1.jpg",
  "/images/medicion/image2.jpg",
  "/images/medicion/image3.jpg",
  "/images/medicion/image4.jpg",
  "/images/medicion/image5.jpg",
];

const mantenimientoGallery = [
  "/images/mantenimiento.jpg",
  "/images/mantenimiento/image2.jpg",
  "/images/mantenimiento/image3.jpg",
  "/images/mantenimiento/image4.jpg",
  "/images/mantenimiento/image5.jpg",
];

const services = [
  {
    title: "Medición de pozos",
    description: "Servicios de medición en circuito cerrado y a la atmósfera con equipo de separación trifásico, manifold de estrangulación, frac tank o presas metálicas y quemador ecológico vertical, con personal capacitado, según requerimientos del cliente.",
    image: "/images/well_testing.jpeg",
    gallery: medicionGallery,
    overlay: "bg-neutral-900/30",
    panelBg: "bg-blue-950/90",
    titleColor: "text-white",
    lineColor: "bg-white",
  },
  {
    title: "Mantenimiento de equipos",
    description: "Mantenimiento de manifold de estrangulación, presas metálicas o frac tank, equipo de separación trifásico, quemador ecológico vertical, tuberías, válvulas y accesorios.",
    image: "/images/mantenimiento.jpg",
    gallery: mantenimientoGallery,
    overlay: "bg-neutral-900/30",
    panelBg: "bg-blue-950/90",
    titleColor: "text-white",
    lineColor: "bg-white",
  },
  {
    title: "Inyección y suministro de químicos",
    description: "Servicio especializado de inyección y suministro de químicos según los requerimientos del proyecto.",
    noImage: true,
    panelBg: "bg-blue-950/90",
    titleColor: "text-white",
    lineColor: "bg-white",
  },
  {
    title: "Pruebas no destructivas",
    description: "Inspecciones y pruebas no destructivas para asegurar integridad y confiabilidad en campo.",
    noImage: true,
    panelBg: "bg-blue-950/90",
    titleColor: "text-white",
    lineColor: "bg-white",
  },
];
---

<section id="servicios" class="bg-white py-20 bg-dots">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 sm:px-8 lg:px-10">
    <div class="space-y-4">
      <p class="section-eyebrow text-blue-600">Servicios</p>
      <div class="space-y-3">
        <h2 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Servicios <span class="text-blue-600">especializados</span></h2>
        <span class="section-divider bg-blue-600"></span>
      </div>
      <p class="mb-4 max-w-4xl text-lg leading-relaxed text-slate-600 sm:text-xl">
        Soluciones técnicas para operación en campo, con equipos certificados y personal capacitado según los requerimientos de cada proyecto.
      </p>
    </div>
    <div class="space-y-10">
      {services.map((service, index) => (
        service.noImage ? (
          <article class="group relative rounded-md border border-slate-200 bg-slate-50/60 p-8 shadow-sm ring-1 ring-blue-100/60" data-service>
            <Image src="/images/talam-logo-white.png" alt="" width={60} height={17} class="pointer-events-none absolute right-6 top-6 z-10 h-auto w-16 opacity-20 invert brightness-50 sm:right-8 sm:w-20" aria-hidden="true" />
            <div class="relative z-10 w-full space-y-2.5">
              <p class="m-0 text-xs font-semibold uppercase tracking-wide text-blue-700/80">Servicio complementario</p>
              <h3 class="m-0 text-xl font-bold leading-tight text-slate-800 sm:text-2xl md:text-3xl">{service.title}</h3>
              <span class="mt-2.5 block h-0.5 w-14 rounded-full bg-slate-300"></span>
              <p class="m-0 text-sm leading-relaxed text-slate-600 sm:text-sm md:text-base">{service.description}</p>
            </div>
          </article>
        ) : (
          <article class="card-lift group relative overflow-hidden rounded-md border border-blue-100/80 shadow-soft" data-service>
            <Image src="/images/talam-logo-white.png" alt="" width={60} height={17} class="pointer-events-none absolute right-4 top-4 z-10 h-auto w-16 opacity-25 sm:right-6 sm:w-20" aria-hidden="true" />
            <div class={`grid min-h-40 overflow-hidden md:min-h-48 md:grid-cols-2 ${index % 2 === 1 ? "md:[&>*:first-child]:order-2" : ""}`}>
              <div class="relative overflow-hidden">
                <Image src={service.image} alt={`Servicio de ${service.title}`} width={1200} height={1200} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                <div class={`absolute inset-0 transition-opacity duration-300 ${service.overlay}`}></div>
                <div class="absolute inset-0 bg-linear-to-t from-neutral-900/35 to-transparent"></div>
              </div>
              <div class={`flex items-center ${service.panelBg} px-6 py-6 text-white sm:px-8 md:px-9`}>
                <div class="space-y-3">
                  <p class="m-0 text-sm font-semibold uppercase tracking-wide text-blue-200">Servicio</p>
                  <h3 class={`m-0 text-2xl font-bold leading-tight sm:text-3xl md:text-4xl ${service.titleColor}`}>{service.title}</h3>
                  <span class={`block h-0.5 w-16 mt-3 rounded-full ${service.lineColor}`}></span>
                  <p class="text-sm leading-relaxed text-white/90 sm:text-base md:text-lg">{service.description}</p>
                  <button type="button" class="cursor-pointer mt-2 inline-flex w-fit items-center gap-2 rounded-md border border-white/70 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white/90 backdrop-blur-[1px] transition-all duration-300 hover:-translate-y-0.5 hover:border-white hover:bg-white/20 hover:text-white" data-modal-open data-modal-title={service.title} data-modal-description={service.description} data-modal-image={service.image} data-modal-gallery={service.gallery ? JSON.stringify(service.gallery) : ""}>
                    Ver más
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </article>
        )
      ))}
    </div>
  </div>
</section>
