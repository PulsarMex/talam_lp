---
const ventasEmail = { label: "Ventas", href: "mailto:ventas@talam.mx", value: "ventas@talam.mx" };

const serviceOptions = [
  "Medición de pozos",
  "Mantenimiento de equipos",
  "Inyección y suministro de químicos",
  "Pruebas no destructivas",
];

const equipmentOptions = [
  "Equipo de separación trifásico",
  "Manifold de estrangulación",
  "Quemador ecológico vertical",
  "Frac tank / presas metálicas",
  "Tubería de alta y baja presión",
];
---

<section id="cotizar" class="bg-white py-16 lg:py-20">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="grid gap-6 rounded-md border border-slate-200 bg-slate-50 shadow-soft lg:grid-cols-2 lg:gap-0">
      <div class="relative rounded-t-md px-8 py-8 sm:px-12 sm:py-10 lg:rounded-l-md lg:rounded-r-none lg:px-16 lg:py-12">
        <div class="flex h-full flex-col justify-center space-y-8">
          <div class="space-y-3">
            <p class="section-eyebrow text-blue-600">Contacto</p>
            <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
              Cotiza con <span class="text-blue-600">nosotros</span>
            </h2>
            <span class="section-divider bg-blue-600"></span>
            <p class="text-lg text-slate-600 sm:text-xl">
              Escríbenos directamente por correo o usa el formulario para una solicitud más estructurada.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <a
              href={ventasEmail.href}
              class="inline-flex items-center gap-3 rounded-md border border-slate-200 bg-white px-5 py-3 text-slate-700 no-underline shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-blue-300 hover:bg-slate-100 hover:text-blue-600 hover:shadow-md"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              <span class="text-left">
                <span class="block text-xs font-medium text-blue-600">{ventasEmail.label}</span>
                <span class="font-semibold text-slate-900">{ventasEmail.value}</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="min-w-0 overflow-hidden rounded-b-md border-t border-slate-200 px-8 py-8 sm:px-12 sm:py-10 lg:rounded-r-md lg:rounded-l-none lg:border-t-0 lg:border-l lg:px-16 lg:py-12">
        <form name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" netlify novalidate class="w-full min-w-0 max-w-full">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              No llenes este campo si eres humano: <input name="bot-field" />
            </label>
          </p>
          <div class="mb-5">
            <label for="contact-name" class="mb-2 block text-sm font-medium text-slate-800">Nombre completo <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              minlength="2"
              maxlength="100"
              autocomplete="name"
              class="contact-input block w-full min-w-0 max-w-full rounded-md border border-slate-200 bg-white p-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
              placeholder="Tu nombre completo"
            />
            <p class="field-error mt-1 hidden text-xs text-red-600"></p>
          </div>
          <div class="mb-5 grid gap-8 md:grid-cols-2">
            <div>
              <label for="contact-email" class="mb-2 block text-sm font-medium text-slate-800">Correo electrónico <span class="text-red-500">*</span></label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
                pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                class="block w-full rounded-md border border-slate-200 bg-white p-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
                placeholder="correo@ejemplo.com"
              />
              <p class="field-error mt-1 hidden text-xs text-red-600"></p>
            </div>
            <div>
              <label for="contact-phone" class="mb-2 block text-sm font-medium text-slate-800">Teléfono <span class="text-red-500">*</span></label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                required
                autocomplete="tel"
                pattern="[0-9+\s\-\(\)]{10,20}"
                minlength="10"
                maxlength="20"
                class="contact-input block w-full min-w-0 max-w-full rounded-md border border-slate-200 bg-white p-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
                placeholder="Número de contacto (10 dígitos mínimo)"
              />
              <p class="field-error mt-1 hidden text-xs text-red-600"></p>
            </div>
          </div>
          <div class="mb-5">
            <label class="mb-3 block text-sm font-medium text-slate-800">Servicios o equipos de interés <span class="text-red-500">*</span> <span class="text-slate-500 font-normal">(selecciona al menos uno)</span></label>
            <div class="space-y-4 rounded-md border border-slate-200 bg-white p-4" id="checkboxes-container">
              <div>
                <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-600">Servicios</p>
                <div class="flex flex-wrap gap-x-4 gap-y-2">
                  {serviceOptions.map((opt) => (
                    <label class="flex items-center gap-2 cursor-pointer my-1">
                      <input
                        type="checkbox"
                        name="services[]"
                        value={opt}
                        class="service-checkbox h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-2 focus:ring-blue-500/20"
                      />
                      <span class="text-sm text-slate-700">{opt}</span>
                    </label>
                  ))}
                </div>
              </div>
              <div class="border-t border-slate-200 pt-4">
                <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-600">Equipos en renta</p>
                <div class="flex flex-wrap gap-x-4 gap-y-2">
                  {equipmentOptions.map((opt) => (
                    <label class="flex items-center gap-2 cursor-pointer my-1">
                      <input
                        type="checkbox"
                        name="equipment[]"
                        value={opt}
                        class="equipment-checkbox h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-2 focus:ring-blue-500/20"
                      />
                      <span class="text-sm text-slate-700">{opt}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
            <p class="field-error mt-1 hidden text-xs text-red-600" id="checkboxes-error">Debes seleccionar al menos un servicio o equipo</p>
          </div>
          <div class="mb-5">
            <label for="contact-message" class="mb-2 block text-sm font-medium text-slate-800">Mensaje <span class="text-red-500">*</span></label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              minlength="10"
              maxlength="2000"
              class="contact-input block w-full min-w-0 max-w-full rounded-md border border-slate-200 bg-white p-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
              placeholder="Describe tu proyecto, necesidades específicas, fechas requeridas o cualquier información adicional que consideres relevante"
            ></textarea>
            <p class="field-error mt-1 hidden text-xs text-red-600"></p>
          </div>
          <button
            type="submit"
            id="submit-btn"
            disabled
            class="w-full cursor-pointer rounded-md border-0 bg-blue-600 px-5 py-3 text-center text-sm font-semibold text-white focus:outline-none transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Enviar solicitud
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  #cotizar form {
    box-sizing: border-box;
  }
  #cotizar .contact-input,
  #cotizar .contact-select {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }
  #cotizar .form-success {
    display: none !important;
    padding: 1.125rem 1.5rem !important;
    margin-bottom: 2rem !important;
    border-radius: 0.5rem !important;
    background-color: #f0fdf4 !important;
    border: 2px solid #22c55e !important;
    color: #15803d !important;
    font-size: 0.9375rem !important;
    font-weight: 500 !important;
    line-height: 1.6 !important;
  }
  #cotizar .form-success.show {
    display: block !important;
  }
  #cotizar .form-error {
    display: none !important;
    padding: 1.125rem 1.5rem !important;
    margin-bottom: 2rem !important;
    border-radius: 0.5rem !important;
    background-color: #fef2f2 !important;
    border: 2px solid #ef4444 !important;
    color: #b91c1c !important;
    font-size: 0.9375rem !important;
    font-weight: 500 !important;
    line-height: 1.6 !important;
  }
  #cotizar .form-error.show {
    display: block !important;
  }
  input.invalid,
  textarea.invalid {
    border-color: #ef4444;
  }
  #checkboxes-container.invalid {
    border-color: #ef4444;
  }
  .field-error {
    display: none;
    margin-top: 0.5rem;
    color: #b91c1c;
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .field-error.show {
    display: block;
  }
</style>

<script is:inline>
(function() {
  const form = document.querySelector('form[name="contact"]');
  if (!form) return;

  const submitButton = document.getElementById('submit-btn');
  const checkboxes = form.querySelectorAll('.service-checkbox, .equipment-checkbox');

  function hasAtLeastOneCheckbox() {
    return Array.from(checkboxes).some(cb => cb.checked);
  }

  function validateForm() {
    const name = document.getElementById('contact-name').value.trim();
    const email = document.getElementById('contact-email').value.trim();
    const phone = document.getElementById('contact-phone').value.trim();
    const message = document.getElementById('contact-message').value.trim();
    
    return name.length >= 2 && 
           email.includes('@') && 
           phone.replace(/[\s\-\(\)]/g, '').length >= 10 && 
           message.length >= 10 && 
           hasAtLeastOneCheckbox();
  }

  function updateSubmitButton() {
    submitButton.disabled = !validateForm();
  }

  // Validar al cambiar cualquier campo
  form.addEventListener('input', updateSubmitButton);
  form.addEventListener('change', updateSubmitButton);
  updateSubmitButton();

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    if (!validateForm()) {
      showMessage('error', 'Por favor, completa todos los campos correctamente.');
      return;
    }

    const originalText = submitButton.textContent;
    submitButton.disabled = true;
    submitButton.textContent = 'Enviando...';

    try {
      const formData = new FormData(form);
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData).toString()
      });

      if (response.ok) {
        form.reset();
        showMessage('success', '¡Gracias! Tu solicitud ha sido enviada. Nos pondremos en contacto contigo pronto.');
        submitButton.textContent = originalText;
        updateSubmitButton();
      } else {
        throw new Error('Error al enviar');
      }
    } catch (error) {
      showMessage('error', 'Hubo un error al enviar tu solicitud. Por favor, intenta nuevamente o contáctanos directamente por correo.');
      submitButton.textContent = originalText;
      submitButton.disabled = false;
    }
  });

  function showMessage(type, text) {
    const existing = form.querySelector('.form-success, .form-error');
    if (existing) existing.remove();

    const messageDiv = document.createElement('div');
    messageDiv.className = `form-${type} show`;
    messageDiv.textContent = text;
    
    // Aplicar estilos directamente
    if (type === 'success') {
      messageDiv.style.cssText = 'display: block !important; padding: 1.125rem 1.5rem !important; margin-bottom: 2rem !important; border-radius: 0.5rem !important; background-color: #f0fdf4 !important; border: 2px solid #22c55e !important; color: #15803d !important; font-size: 0.9375rem !important; font-weight: 500 !important; line-height: 1.6 !important;';
    } else {
      messageDiv.style.cssText = 'display: block !important; padding: 1.125rem 1.5rem !important; margin-bottom: 2rem !important; border-radius: 0.5rem !important; background-color: #fef2f2 !important; border: 2px solid #ef4444 !important; color: #b91c1c !important; font-size: 0.9375rem !important; font-weight: 500 !important; line-height: 1.6 !important;';
    }
    
    form.insertBefore(messageDiv, form.firstChild);

    setTimeout(() => {
      messageDiv.style.display = 'none';
      setTimeout(() => messageDiv.remove(), 300);
    }, 5000);
  }
})();
</script>

