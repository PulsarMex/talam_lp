---
const emails = [
  { label: "Ventas", href: "mailto:ventas@talam.mx", value: "ventas@talam.mx" },
  { label: "Operaciones", href: "mailto:operaciones@talam.mx", value: "operaciones@talam.mx" },
];
---

<section id="cotizar" class="bg-white py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-10">
    <div class="relative rounded-md bg-blue-600 px-8 py-12 text-white shadow-2xl sm:px-12 sm:py-16 lg:px-16 lg:py-20">
      <div class="mx-auto max-w-2xl space-y-8 text-center">
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-wider text-blue-200">Contacto</p>
          <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            Cotiza con nosotros
          </h2>
          <span class="mx-auto block h-1 w-16 rounded-full bg-blue-400"></span>
          <p class="text-lg text-white/90 sm:text-xl">
            Escríbenos para solicitar equipo, servicios de medición o apoyo en campo.
          </p>
        </div>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap sm:gap-6">
          {emails.map((item) => (
            <a
              href={item.href}
              class="inline-flex items-center gap-3 rounded-md bg-white/15 px-5 py-3 text-white transition-colors hover:bg-white/25"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              <span class="text-left">
                <span class="block text-xs font-medium text-blue-200">{item.label}</span>
                <span class="font-semibold">{item.value}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
