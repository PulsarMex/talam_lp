---
const heroVideo = "/images/hero.mp4";
const heroPoster = "/images/hero-poster.jpg";
---

<section id="inicio" class="relative min-h-screen overflow-hidden bg-black">
  <div class="hero-video-zoom absolute inset-0 overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full origin-left object-cover object-center transform-[scale(1.2)]"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={heroPoster}
      aria-hidden="true"
    >
      <source src={heroVideo} type="video/mp4" />
    </video>
  </div>
  <div class="absolute inset-0 bg-linear-to-b from-neutral-950/75 via-neutral-900/70 to-neutral-950/80"></div>
  <div class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-center justify-center px-6 text-center sm:px-8 lg:px-10">
    <div class="max-w-4xl space-y-7">
      <p class="section-eyebrow text-blue-200">Maquinaria y Suministros</p>
      <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
        Equipos y servicio para el sector <span class="text-blue-200">energético</span>
      </h1>
      <p class="mx-auto max-w-3xl text-lg leading-relaxed text-white/90 sm:text-xl">
        Renta de equipo y operación técnica con respuesta ágil y confiable en el sureste de México.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-3">
        <a href="#servicios" class="cursor-pointer rounded-md border border-white/40 bg-white/95 px-8 py-4 text-base font-semibold text-blue-900 shadow-soft no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:shadow-soft-lg">
          Explorar servicios
        </a>
        <a href="#cotizar" class="cursor-pointer rounded-md bg-blue-600 px-8 py-4 text-base font-semibold text-white shadow-soft no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-500 hover:shadow-soft-lg">
          Habla con nosotros
        </a>
      </div>
    </div>
  </div>
</section>
