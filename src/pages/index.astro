---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import AboutTabs from "../components/AboutTabs.astro";
import QualityPolicy from "../components/QualityPolicy.astro";
import Services from "../components/Services.astro";
import Equipment from "../components/Equipment.astro";
import Coverage from "../components/Coverage.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Talam | Maquinaria y Suministros";
const description =
  "Talam Maquinaria y Suministros ofrece renta de equipo de medición y servicio completo en campo para operaciones petroleras en el sureste de México.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Talam Maquinaria y Suministros",
  description: description,
  url: "https://talam.mx",
  contactPoint: [
    { "@type": "ContactPoint", contactType: "Ventas", email: "ventas@talam.mx", areaServed: "MX", availableLanguage: "Spanish" },
    { "@type": "ContactPoint", contactType: "Operaciones", email: "operaciones@talam.mx", areaServed: "MX", availableLanguage: "Spanish" },
  ],
  address: {
    "@type": "PostalAddress",
    addressCountry: "MX",
  },
  sameAs: [],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Header />
  <main class="bg-white text-slate-900">
    <Hero />
    <AboutTabs />
    <Services />
    <Equipment />
    <QualityPolicy />
    <Coverage />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
